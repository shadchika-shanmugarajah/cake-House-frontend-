PORT=5000
MONGODB_URI=your_mongodb_connection_string

# Email (when admin confirms/cancels bulk order)
# Gmail: use App Password from Google Account > Security > 2-Step Verification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your-email@gmail.com

# SMS via Twilio (optional)
# Sign up at twilio.com, get credentials from console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1234567890
